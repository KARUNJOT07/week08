{
  "title": "KoalaTech - Application and Cluster Health (10.2D)",
  "uid": "koalatech-10-2d",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-30m", "to": "now" },
  "tags": ["sit722", "10.2D", "koalatech"],
  "panels": [
    { "id": 1, "type": "stat", "title": "student-service scrape status (1 = up)",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "up{job=\"student-service\"}" } ] },
    { "id": 2, "type": "stat", "title": "Production pods running",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum(kube_pod_status_phase{namespace=\"production\", phase=\"Running\"})" } ] },
    { "id": 3, "type": "stat", "title": "student-service requests (last 5m)",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum(increase(http_requests_total{job=\"student-service\"}[5m]))" } ] },
    { "id": 4, "type": "stat", "title": "student-service 5xx errors (last 5m)",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum(increase(http_requests_total{job=\"student-service\", status=\"5xx\"}[5m])) or vector(0)" } ] },
    { "id": 5, "type": "timeseries", "title": "student-service request rate by endpoint (req/s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum by (handler) (rate(http_requests_total{job=\"student-service\"}[1m]))", "legendFormat": "{{handler}}" } ] },
    { "id": 6, "type": "timeseries", "title": "student-service p95 latency (seconds)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"student-service\"}[5m])))", "legendFormat": "p95" } ] },
    { "id": 7, "type": "timeseries", "title": "CPU usage by pod - production (cores)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"production\", container!=\"\"}[5m]))", "legendFormat": "{{pod}}" } ] },
    { "id": 8, "type": "timeseries", "title": "Memory working set by pod - production (MiB)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"production\", container!=\"\"}) / 1048576", "legendFormat": "{{pod}}" } ] }
  ]
}
